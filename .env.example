# Только ключи Binance Spot Testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

# Токен от BotFather. Не публиковать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false — не присылать ранние/сильные сигналы; сделки и отчёты остаются.
TELEGRAM_SIGNAL_ALERTS_ENABLED=false

# Ключ ИИ-аналитика OpenAI. Не публиковать.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Публичные рыночные данные. Торговые ключи сюда не отправляются.
MARKET_DATA_BASE_URL=https://api.binance.com
SCAN_ALL_USDT=true
# Используется только если SCAN_ALL_USDT=false
WATCH_SYMBOLS=DOGEUSDT,SHIBUSDT,PEPEUSDT,BONKUSDT,FLOKIUSDT,WIFUSDT
MIN_QUOTE_VOLUME_USDT=500000
PUMP_WINDOW_SECONDS=300
EARLY_THRESHOLD_PERCENT=0.5
PUMP_THRESHOLD_PERCENT=3
MAX_SIGNALS_PER_CYCLE=5
ENTRY_CONFIRMATION_SECONDS=20
ESTIMATED_ROUND_TRIP_COST_PERCENT=0.2
PAPER_TRADING_ENABLED=true
PAPER_STARTING_BALANCE_USDT=200
PAPER_POSITION_USDT=50
PAPER_MAX_OPEN_POSITIONS=4
PAPER_MIN_AI_SCORE=70
PAPER_STOP_LOSS_PERCENT=0.5
PAPER_TAKE_PROFIT_1_PERCENT=0.7
PAPER_TAKE_PROFIT_2_PERCENT=1
# Зарезервированный совместимый параметр; текущая схема полностью закрывается на второй цели.
PAPER_TAKE_PROFIT_3_PERCENT=1.5
PAPER_TRAILING_DRAWDOWN_PERCENT=1
# 0 — без принудительного выхода по времени
PAPER_MAX_HOLD_SECONDS=0
# Через 15 минут проверять, затух ли импульс; окно без нового максимума — 5 минут.
# Такой выход разрешён только с положительным результатом после учёта расходов.
PAPER_STAGNATION_AFTER_SECONDS=900
PAPER_STAGNATION_WINDOW_SECONDS=300
POLL_INTERVAL_SECONDS=15
ALERT_COOLDOWN_SECONDS=1800
AUDIT_DB_PATH=data/monitor.db
